@@ -0,0 +1,106 @@
+import { useEffect, useRef, useState } from 'react';
+import type { ReactNode } from 'react';
+import { useNavigate, useParams } from 'react-router-dom';
+
+import { api } from '@/shared/api';
+import type { Plugin, Project } from '@/shared/types';
+import { useTheme } from '@/shared/context/ThemeContext';
+import {
+  loadToolRendererModule,
+  type PluginToolContext,
+  type PluginToolHandle,
+} from '@/modules/plugins/tool-renderers/loadToolRendererModule';
+
+type PluginToolRendererProps = {
+  plugin: Plugin;
+  toolName: string;
+  toolId?: string;
+  toolInput: unknown;
+  toolResult?: { content?: unknown; isError?: boolean } | null;
+  status: PluginToolContext['status'];
+  selectedProject?: Project | null;
+  /** The host's own rendering, shown until the plugin draws and whenever it cannot. */
+  fallback: ReactNode;
+};
+
+/**
+ * Renders one chat tool row with a plugin's `renderTool`. Rendered by chat's ToolRenderer for tools a plugin
+ * claims through `toolRenderers` in its manifest. Any failure keeps the host's own rendering.
+ */
+export default function PluginToolRenderer({
+  plugin, toolName, toolId, toolInput, toolResult, status, selectedProject, fallback,
+}: PluginToolRendererProps) {
+  const containerRef = useRef<HTMLDivElement>(null);
+  const handleRef = useRef<PluginToolHandle | null>(null);
+  const [state, setState] = useState<'loading' | 'ready' | 'failed'>('loading');
+  const { isDarkMode } = useTheme();
+  const navigate = useNavigate();
+  const { sessionId = null } = useParams();
+
+  const context: PluginToolContext = {
+    toolName,
+    toolId: toolId ?? null,
+    toolInput,
+    toolResult: toolResult ? { content: toolResult.content ?? null, isError: Boolean(toolResult.isError) } : null,
+    status,
+    theme: isDarkMode ? 'dark' : 'light',
+    project: selectedProject
+      ? { name: selectedProject.projectId, path: selectedProject.fullPath || selectedProject.path || '' }
+      : null,
+    sessionId,
+  };
+  const contextRef = useRef(context);
+  contextRef.current = context;
+  const navigateRef = useRef(navigate);
+  navigateRef.current = navigate;
+
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return undefined;
+    let active = true;
+    (async () => {
+      try {
+        const mod = await loadToolRendererModule(plugin.name, plugin.entry);
+        if (!active) return;
+        if (typeof mod.renderTool !== 'function') throw new Error('plugin module has no renderTool export');
+        const handle = await mod.renderTool(container, contextRef.current, {
+          async rpc(method, path, body) {
+            const res = await api.plugins.rpc(plugin.name, method, path, body);
+            if (!res.ok) throw new Error(`RPC error ${res.status}`);
+            return res.json();
+          },
+          openSession: (id) => navigateRef.current(`/session/${encodeURIComponent(id)}`),
+        });
+        if (!active) {
+          handle?.destroy?.();
+          return;
+        }
+        handleRef.current = handle ?? null;
+        setState('ready');
+      } catch (error) {
+        console.error(`[Plugin:${plugin.name}] renderTool failed for ${toolName}:`, error);
+        if (active) setState('failed');
+      }
+    })();
+    return () => {
+      active = false;
+      try { handleRef.current?.destroy?.(); } catch { /* plugin error — ignore */ }
+      handleRef.current = null;
+      container.replaceChildren();
+    };
+  }, [plugin.name, plugin.entry, toolName]);
+
+  // Push every prop change (streamed input, the result arriving, theme) to the mounted renderer.
+  const contextKey = JSON.stringify([toolInput, toolResult?.content, toolResult?.isError, status, isDarkMode, sessionId]);
+  useEffect(() => {
+    if (state !== 'ready') return;
+    try { handleRef.current?.update?.(contextRef.current); } catch { /* plugin error — ignore */ }
+  }, [contextKey, state]);
+
+  return (
+    <>
+      {state !== 'ready' && fallback}
+      <div ref={containerRef} hidden={state !== 'ready'} data-plugin-tool={plugin.name} />
+    </>
+  );
+}
diff --git a/src/modules/plugins/tool-renderers/loadToolRendererModule.ts b/src/modules/plugins/tool-renderers/loadToolRendererModule.ts
new file mode 100644
index 00000000..0ad30e69
--- /dev/null
+++ b/src/modules/plugins/tool-renderers/loadToolRendererModule.ts
@@ -0,0 +1,57 @@
+import { api } from '@/shared/api';
+
+/** What a plugin module exports to render chat rows for the tools its manifest lists in `toolRenderers`. */
+export type PluginToolRendererModule = {
+  renderTool?: (
+    container: HTMLElement,
+    context: PluginToolContext,
+    host: PluginToolHostApi,
+  ) => PluginToolHandle | void | Promise<PluginToolHandle | void>;
+};
+
+export type PluginToolContext = {
+  toolName: string;
+  toolId: string | null;
+  toolInput: unknown;
+  toolResult: { content: unknown; isError: boolean } | null;
+  status: 'running' | 'completed' | 'error' | 'denied';
+  theme: 'dark' | 'light';
+  project: { name: string; path: string } | null;
+  /** App session id of the conversation this row belongs to. */
+  sessionId: string | null;
+};
+
+export type PluginToolHostApi = {
+  rpc(method: string, path: string, body?: unknown): Promise<unknown>;
+  /** Opens another session in the app, e.g. a session the tool started. */
+  openSession(sessionId: string): void;
+};
+
+export type PluginToolHandle = {
+  update?: (context: PluginToolContext) => void;
+  destroy?: () => void;
+};
+
+// One module instance per plugin for every tool row it renders, loaded the way the tab slot loads it:
+// fetched with auth headers, then imported from a Blob URL.
+const modules = new Map<string, Promise<PluginToolRendererModule>>();
+
+export function loadToolRendererModule(pluginName: string, entry: string): Promise<PluginToolRendererModule> {
+  const key = `${pluginName}:${entry}`;
+  let pending = modules.get(key);
+  if (!pending) {
+    pending = (async () => {
+      const res = await api.plugins.asset(pluginName, entry);
+      if (!res.ok) throw new Error(`Failed to fetch plugin (HTTP ${res.status})`);
+      const blobUrl = URL.createObjectURL(new Blob([await res.text()], { type: 'application/javascript' }));
+      try {
+        return (await import(/* @vite-ignore */ blobUrl)) as PluginToolRendererModule;
+      } finally {
+        URL.revokeObjectURL(blobUrl);
+      }
+    })();
+    pending.catch(() => modules.delete(key)); // let a later row retry after a failure
+    modules.set(key, pending);
+  }
+  return pending;
+}
diff --git a/src/modules/plugins/tool-renderers/matchToolRenderer.ts b/src/modules/plugins/tool-renderers/matchToolRenderer.ts
new file mode 100644
index 00000000..40897a8a
--- /dev/null
+++ b/src/modules/plugins/tool-renderers/matchToolRenderer.ts
@@ -0,0 +1,12 @@
+import type { Plugin } from '@/shared/types';
+
+/** True when a manifest pattern (an exact tool name, or a prefix ending in `*`) covers `toolName`. */
+export function toolPatternMatches(pattern: string, toolName: string): boolean {
+  return pattern.endsWith('*') ? toolName.startsWith(pattern.slice(0, -1)) : pattern === toolName;
+}
+
+/** The first enabled plugin that renders `toolName`, in the host's plugin order. */
+export function findToolRendererPlugin(plugins: Plugin[], toolName: string): Plugin | null {
+  return plugins.find((plugin) => plugin.enabled
+    && (plugin.toolRenderers ?? []).some((pattern) => toolPatternMatches(pattern, toolName))) ?? null;
+}
