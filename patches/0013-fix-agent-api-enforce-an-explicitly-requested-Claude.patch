From bfa1dfec60ab94633dabde05660fce0c08938b22 Mon Sep 17 00:00:00 2001
From: hectorqin <14220132+hectorqin@users.noreply.github.com>
Date: Thu, 26 Nov 2026 09:37:40 +0000
Subject: [PATCH 13/13] fix(agent-api): enforce an explicitly requested Claude
 permission mode

mapCliOptionsToSDK drops 'default' so a chat turn follows the user's
permissions.defaultMode. For an Agent API request that explicitly asks
for 'default', that meant a user-level bypass setting silently skipped
the approvals the caller asked for. The route now passes
enforcePermissionMode when the request names a mode, and the mapper
then hands the mode to the SDK as is. Chat turns are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 server/modules/agent/agent.routes.ts          |  2 ++
 .../modules/agent/tests/agent.routes.test.ts  | 13 +++++++++--
 .../list/claude/claude-runtime.provider.ts    | 11 ++++++---
 .../tests/claude-permission-mode.test.ts      | 23 +++++++++++++++++++
 4 files changed, 44 insertions(+), 5 deletions(-)
 create mode 100644 server/modules/providers/tests/claude-permission-mode.test.ts

diff --git a/server/modules/agent/agent.routes.ts b/server/modules/agent/agent.routes.ts
index 53565fc1..f8442773 100644
--- a/server/modules/agent/agent.routes.ts
+++ b/server/modules/agent/agent.routes.ts
@@ -1124,6 +1124,8 @@ export function createAgentRouter(dependencies: AgentRouterDependencies): expres
           model: model || providerModels?.DEFAULT,
           effort,
           permissionMode,
+          // An explicitly requested mode is applied as is, even 'default' (see mapCliOptionsToSDK).
+          enforcePermissionMode: requestedPermissionMode !== null,
           // A caller that only reads this response cannot answer an MCP form;
           // one whose run a person watches in the UI says so with `false`.
           unattended
diff --git a/server/modules/agent/tests/agent.routes.test.ts b/server/modules/agent/tests/agent.routes.test.ts
index d5f0749b..aae38d4b 100644
--- a/server/modules/agent/tests/agent.routes.test.ts
+++ b/server/modules/agent/tests/agent.routes.test.ts
@@ -328,8 +328,8 @@ async function runWithoutModel(
   return { models, catalogReads };
 }
 
-async function startClaudeRunWith(extraBody: Record<string, unknown>): Promise<{ unattended?: boolean; permissionMode?: string }> {
-  const runOptions: { unattended?: boolean; permissionMode?: string }[] = [];
+async function startClaudeRunWith(extraBody: Record<string, unknown>): Promise<{ unattended?: boolean; permissionMode?: string; enforcePermissionMode?: boolean }> {
+  const runOptions: { unattended?: boolean; permissionMode?: string; enforcePermissionMode?: boolean }[] = [];
   await withAgentServer(createDependencies({
     fileSystem: { access: async () => undefined } as unknown as AgentDependencies['fileSystem'],
     models: {
@@ -536,3 +536,12 @@ test('Agent session status reports whether a run is in progress without starting
     assert.equal((await fetch(`${baseUrl}/api/agent/sessions/nope`)).status, 404);
   });
 });
+
+test('Agent route enforces an explicitly requested Claude mode and leaves the implicit default as before', async () => {
+  const explicit = await startClaudeRunWith({ permissionMode: 'default' });
+  assert.equal(explicit.permissionMode, 'default');
+  assert.equal(explicit.enforcePermissionMode, true);
+  const implicit = await startClaudeRunWith({});
+  assert.equal(implicit.permissionMode, 'bypassPermissions');
+  assert.equal(implicit.enforcePermissionMode, false);
+});
diff --git a/server/modules/providers/list/claude/claude-runtime.provider.ts b/server/modules/providers/list/claude/claude-runtime.provider.ts
index 4e8f9f4f..af0f63f0 100644
--- a/server/modules/providers/list/claude/claude-runtime.provider.ts
+++ b/server/modules/providers/list/claude/claude-runtime.provider.ts
@@ -377,8 +377,10 @@ export function buildClaudeSdkEnv(hostEnv: NodeJS.ProcessEnv = process.env): Nod
   };
 }
 
-function mapCliOptionsToSDK(options: AnyRecord = {}) {
-  const { providerSessionId, cwd, toolsSettings, permissionMode, effort, resumeAnchorId, resumeFromScratch } = options;
+export function mapCliOptionsToSDK(options: AnyRecord = {}) {
+  const {
+    providerSessionId, cwd, toolsSettings, permissionMode, effort, resumeAnchorId, resumeFromScratch, enforcePermissionMode,
+  } = options;
 
   const sdkOptions: AnyRecord = {};
 
@@ -397,7 +399,10 @@ function mapCliOptionsToSDK(options: AnyRecord = {}) {
     sdkOptions.cwd = cwd;
   }
 
-  if (permissionMode && permissionMode !== 'default') {
+  // A chat turn's 'default' means "whatever the user's settings say", so it is left unset and the SDK applies
+  // permissions.defaultMode. A caller that explicitly asked for a mode (the Agent API) gets exactly that mode,
+  // including 'default', so a user-level bypass setting cannot silently skip the approvals it asked for.
+  if (permissionMode && (permissionMode !== 'default' || enforcePermissionMode === true)) {
     sdkOptions.permissionMode = permissionMode;
   }
 
diff --git a/server/modules/providers/tests/claude-permission-mode.test.ts b/server/modules/providers/tests/claude-permission-mode.test.ts
new file mode 100644
index 00000000..3bb877d6
--- /dev/null
+++ b/server/modules/providers/tests/claude-permission-mode.test.ts
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { mapCliOptionsToSDK } from '@/modules/providers/list/claude/claude-runtime.provider.js';
+
+// A chat turn's 'default' defers to the user's settings (permissions.defaultMode), so the SDK gets no mode.
+test('a chat default leaves the mode to the user settings', () => {
+  assert.equal(mapCliOptionsToSDK({ permissionMode: 'default' }).permissionMode, undefined);
+  assert.equal(mapCliOptionsToSDK({}).permissionMode, undefined);
+});
+
+// An Agent API caller that explicitly asked for manual approval must get it, even if the user's settings
+// default to bypassPermissions.
+test('an explicitly requested default reaches the SDK as manual approval', () => {
+  assert.equal(mapCliOptionsToSDK({ permissionMode: 'default', enforcePermissionMode: true }).permissionMode, 'default');
+});
+
+test('non-default modes pass through either way', () => {
+  for (const mode of ['acceptEdits', 'plan', 'bypassPermissions']) {
+    assert.equal(mapCliOptionsToSDK({ permissionMode: mode }).permissionMode, mode);
+    assert.equal(mapCliOptionsToSDK({ permissionMode: mode, enforcePermissionMode: true }).permissionMode, mode);
+  }
+});
-- 
