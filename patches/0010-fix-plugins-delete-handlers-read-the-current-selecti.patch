@@ -122,3 +122,21 @@ test('cleanup after a pending request uses the latest workspace callbacks (selec
 
   assert.deepEqual(calls, ['after:removeProject:p-1', 'after:refresh', 'after:removeSession:s-1', 'after:refresh']);
