From 34e539f670366aec54befff930c4a2dcdd498e04 Mon Sep 17 00:00:00 2001
From: hectorqin <14220132+hectorqin@users.noreply.github.com>
Date: Thu, 26 Nov 2026 09:02:17 +0000
Subject: [PATCH 8/8] fix(plugins): reconcile local state after plugin
 archive/delete

After a successful request, drop the project or session from local
state the same way the sidebar does before refreshing. The refresh
merges loaded session pages and would otherwise restore an archived or
deleted session, and a deleted selection would stay open.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../tests/pluginProjectActions.test.ts        | 30 ++++++++++++++++++-
 .../plugins/usePluginProjectActions.ts        |  5 ++++
 .../context/ProjectsStateContext.tsx          | 11 ++++++-
 3 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/src/modules/plugins/tests/pluginProjectActions.test.ts b/src/modules/plugins/tests/pluginProjectActions.test.ts
index d7e00d0d..d94e20b7 100644
--- a/src/modules/plugins/tests/pluginProjectActions.test.ts
+++ b/src/modules/plugins/tests/pluginProjectActions.test.ts
@@ -5,7 +5,12 @@ import { test, vi } from 'vitest';
 
 const deleteProject = vi.fn();
 const deleteSession = vi.fn();
-let workspace: { projects: { projectId: string; fullPath: string; worktreeOf?: string | null }[]; refresh: () => Promise<void> } | null = null;
+let workspace: {
+  projects: { projectId: string; fullPath: string; worktreeOf?: string | null }[];
+  refresh: () => Promise<void>;
+  removeProject?: (id: string) => void;
+  removeSession?: (id: string) => void;
+} | null = null;
 
 vi.mock('@/shared/api', () => ({
   api: { deleteProject: (...args: unknown[]) => deleteProject(...args), deleteSession: (...args: unknown[]) => deleteSession(...args) },
@@ -63,3 +68,26 @@ test('session archive and delete call the sidebar session request and refresh',
   deleteSession.mockResolvedValue({ ok: false, status: 404, json: async () => ({ error: 'Session not found' }) });
   assert.deepEqual(await result.current!('nope', 'archive'), { ok: false, error: 'Session not found' });
 });
+
+test('successful actions drop the target locally before refreshing, so a refresh merge cannot bring it back', async () => {
+  const order: string[] = [];
+  const refresh = vi.fn(async () => { order.push('refresh'); });
+  workspace = {
+    projects: [{ projectId: 'p-1', fullPath: '/src/app-worktrees/w1', worktreeOf: '/src/app' }],
+    refresh,
+    removeProject: (id) => order.push(`removeProject:${id}`),
+    removeSession: (id) => order.push(`removeSession:${id}`),
+  };
+  deleteProject.mockResolvedValue({ ok: true });
+  deleteSession.mockResolvedValue({ ok: true });
+  const projects = renderHook(() => usePluginProjectActions()).result;
+  const sessions = renderHook(() => usePluginSessionActions()).result;
+  await projects.current!('/src/app-worktrees/w1', 'archive');
+  await sessions.current!('s-2', 'archive');
+  assert.deepEqual(order, ['removeProject:p-1', 'refresh', 'removeSession:s-2', 'refresh']);
+
+  order.length = 0;
+  deleteSession.mockResolvedValue({ ok: false, status: 500, json: async () => ({ error: 'nope' }) });
+  await sessions.current!('s-3', 'delete');
+  assert.deepEqual(order, [], 'nothing is removed locally when the request fails');
+});
diff --git a/src/modules/plugins/usePluginProjectActions.ts b/src/modules/plugins/usePluginProjectActions.ts
index 7b903435..bfad2ae0 100644
--- a/src/modules/plugins/usePluginProjectActions.ts
+++ b/src/modules/plugins/usePluginProjectActions.ts
@@ -40,6 +40,8 @@ export function usePluginProjectActions():
       const body = await response.json().catch(() => null);
       return { ok: false, error: readApiErrorMessage(body) ?? `Request failed (${response.status})` };
     }
+    // Same local cleanup as the sidebar: drop it (leaving it first if it is selected), then resync.
+    current.removeProject?.(project.projectId);
     await current.refresh();
     return { ok: true };
   }, []);
@@ -69,6 +71,9 @@ export function usePluginSessionActions():
       const body = await response.json().catch(() => null);
       return { ok: false, error: readApiErrorMessage(body) ?? `Request failed (${response.status})` };
     }
+    // Remove it locally before refreshing: the refresh merges loaded session pages and would otherwise put an
+    // archived or deleted session back. This also leaves it if it was the selected session.
+    current.removeSession?.(sessionId);
     await current.refresh();
     return { ok: true };
   }, []);
diff --git a/src/modules/project-workspace/context/ProjectsStateContext.tsx b/src/modules/project-workspace/context/ProjectsStateContext.tsx
index d015ccee..2960e120 100644
--- a/src/modules/project-workspace/context/ProjectsStateContext.tsx
+++ b/src/modules/project-workspace/context/ProjectsStateContext.tsx
@@ -199,9 +199,18 @@ export function useProjectActiveSessionState(): ProjectActiveSessionState {
 export function useOptionalProjectActions(): {
   projects: ProjectsState['sidebarSharedProps']['projects'];
   refresh: ProjectsState['refreshProjectsSilently'];
+  /** Drops a project from local state and leaves it if it was selected, as the sidebar's delete does. */
+  removeProject: ProjectsState['sidebarSharedProps']['onProjectDelete'];
+  /** Drops a session from local state and leaves it if it was selected, as the sidebar's session delete does. */
+  removeSession: ProjectsState['sidebarSharedProps']['onSessionDelete'];
 } | null {
   const sidebar = useContext(ProjectSidebarContext);
   const main = useContext(ProjectMainContext);
   if (!sidebar || !main) return null;
-  return { projects: sidebar.sidebarSharedProps.projects, refresh: main.refreshProjectsSilently };
+  return {
+    projects: sidebar.sidebarSharedProps.projects,
+    refresh: main.refreshProjectsSilently,
+    removeProject: sidebar.sidebarSharedProps.onProjectDelete,
+    removeSession: sidebar.sidebarSharedProps.onSessionDelete,
+  };
 }
