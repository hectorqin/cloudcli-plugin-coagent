@@ -122,9 +122,9 @@ export default function PluginToolRenderer({
 
   // Push every prop change (streamed input, the result arriving, theme, project) to the mounted renderer. A renderer
   // whose update throws is released and the host rendering comes back.
+  // Keyed on the exact values handed to the plugin (context.project included), so nothing it sees can change silently.
   const contextKey = JSON.stringify([
-    toolInput, toolResult?.content, toolResult?.isError, status, isDarkMode, sessionId,
-    selectedProject?.projectId ?? null, selectedProject?.fullPath ?? selectedProject?.path ?? null,
+    toolInput, toolResult?.content, toolResult?.isError, status, isDarkMode, sessionId, context.project,
   ]);
   useEffect(() => {
     if (state !== 'ready') return;
diff --git a/src/modules/plugins/tool-renderers/loadToolRendererModule.ts b/src/modules/plugins/tool-renderers/loadToolRendererModule.ts
index f7a4fa66..b11f8d74 100644
--- a/src/modules/plugins/tool-renderers/loadToolRendererModule.ts
+++ b/src/modules/plugins/tool-renderers/loadToolRendererModule.ts
@@ -58,7 +58,11 @@ export function loadToolRendererModule(pluginName: string, entry: string): Promi
         URL.revokeObjectURL(blobUrl);
       }
     })();
-    pending.catch(() => modules.delete(key)); // let a later row retry after a failure
+    // Let a later row retry after a failure, but never drop a newer load that replaced this one after an
+    // invalidation.
+    pending.catch(() => {
+      if (modules.get(key) === pending) modules.delete(key);
+    });
     modules.set(key, pending);
   }
   return pending;
