     assert.equal((await post({ provider: 'codex', permissionMode: 'acceptEdits' })).status, 200);
-    for (const [provider, permissionMode] of [['codex', 'plan'], ['cursor', 'default'], ['claude', 'yolo'], ['claude', 42]]) {
